{
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read supabase/functions/create-staff/index.ts",
    "deploy": "supabase functions deploy create-staff"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window", "dom", "esnext"],
    "strict": true
  },
  "imports": {
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.45.4",
    "std/": "https://deno.land/std@0.224.0/"
  },
  "lint": {
    "include": ["supabase/functions/"],
    "exclude": ["node_modules", "css/", "js/"]
  },
  "fmt": {
    "include": ["supabase/functions/"],
    "options": {
      "indentWidth": 2,
      "lineWidth": 110,
      "singleQuote": true
    }
  }
}

